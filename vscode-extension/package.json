{
  "name": "my-md-reader",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.2.0",
  "publisher": "leizongmin",
  "author": "LEI Zongmin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leizongmin/my-md-reader"
  },
  "bugs": {
    "url": "https://github.com/leizongmin/my-md-reader/issues"
  },
  "homepage": "https://github.com/leizongmin/my-md-reader#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Themes"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "katex",
    "toc"
  ],
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:html",
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "MD Reader Light",
        "uiTheme": "vs",
        "path": "./themes/md-reader-light-color-theme.json"
      },
      {
        "label": "MD Reader Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/md-reader-dark-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "myMdReader.preview",
        "title": "%command.preview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "myMdReader.htmlPreview",
        "title": "%command.htmlPreview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "myMdReader.xmlPreview",
        "title": "%command.xmlPreview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "myMdReader.refreshPreview",
        "title": "%command.refreshPreview.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "myMdReader.openPreviewDevTools",
        "title": "%command.openPreviewDevTools.title%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname =~ /\\.(md|mdx|mkd|markdown)$/i",
          "command": "myMdReader.preview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname =~ /\\.(html|htm)$/i",
          "command": "myMdReader.htmlPreview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname =~ /\\.xml$/i",
          "command": "myMdReader.xmlPreview",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname =~ /\\.(md|mdx|mkd|markdown)$/i",
          "command": "myMdReader.preview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname =~ /\\.(html|htm)$/i",
          "command": "myMdReader.htmlPreview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname =~ /\\.xml$/i",
          "command": "myMdReader.xmlPreview",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname =~ /\\.(md|mdx|mkd|markdown)$/i",
          "command": "myMdReader.preview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname =~ /\\.(html|htm)$/i",
          "command": "myMdReader.htmlPreview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname =~ /\\.xml$/i",
          "command": "myMdReader.xmlPreview",
          "group": "navigation"
        },
        {
          "when": "activeWebviewPanelId == 'myMdReader.preview' || activeWebviewPanelId == 'myMdReader.htmlPreview' || activeWebviewPanelId == 'myMdReader.xmlPreview'",
          "command": "myMdReader.refreshPreview",
          "group": "navigation@10"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceExtname =~ /\\.(md|mdx|mkd|markdown)$/i",
          "command": "myMdReader.preview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname =~ /\\.(html|htm)$/i",
          "command": "myMdReader.htmlPreview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname =~ /\\.xml$/i",
          "command": "myMdReader.xmlPreview",
          "group": "navigation"
        },
        {
          "when": "activeWebviewPanelId == 'myMdReader.preview' || activeWebviewPanelId == 'myMdReader.htmlPreview' || activeWebviewPanelId == 'myMdReader.xmlPreview'",
          "command": "myMdReader.refreshPreview",
          "group": "1_preview"
        },
        {
          "when": "activeWebviewPanelId == 'myMdReader.htmlPreview' || activeWebviewPanelId == 'myMdReader.xmlPreview'",
          "command": "myMdReader.openPreviewDevTools",
          "group": "1_preview"
        }
      ],
      "webview/context": [
        {
          "when": "webviewId == 'myMdReader.preview' || webviewId == 'myMdReader.htmlPreview' || webviewId == 'myMdReader.xmlPreview'",
          "command": "myMdReader.refreshPreview",
          "group": "navigation@1"
        },
        {
          "when": "webviewId == 'myMdReader.htmlPreview' || webviewId == 'myMdReader.xmlPreview'",
          "command": "myMdReader.openPreviewDevTools",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "myMdReader.pageTheme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "default": "auto",
          "description": "%configuration.pageTheme.description%"
        },
        "myMdReader.pageWidth": {
          "type": "string",
          "enum": [
            "default",
            "full"
          ],
          "default": "default",
          "description": "%configuration.pageWidth.description%"
        },
        "myMdReader.centered": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.centered.description%"
        },
        "myMdReader.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 32,
          "description": "%configuration.fontSize.description%"
        },
        "myMdReader.showLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.showLineNumbers.description%"
        },
        "myMdReader.hiddenSide": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.hiddenSide.description%"
        },
        "myMdReader.mdPlugins": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Emoji",
              "Sub",
              "Sup",
              "Ins",
              "Abbr",
              "Katex",
              "Mermaid",
              "Mark",
              "Deflist",
              "Footnote",
              "TaskLists",
              "TOC",
              "Alert"
            ]
          },
          "default": [
            "Emoji",
            "Sub",
            "Sup",
            "Ins",
            "Abbr",
            "Katex",
            "Mermaid",
            "Mark",
            "Deflist",
            "Footnote",
            "TaskLists",
            "TOC",
            "Alert"
          ],
          "description": "%configuration.mdPlugins.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "package": "vsce package",
    "test": "node --test test/*.test.js",
    "lint": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.74.0",
    "@vscode/vsce": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "esbuild-loader": "^4.5.0",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@md-reader/theme": "^2.0.5",
    "@mdit/plugin-alert": "^2.0.2",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "highlight.js": "^11.12.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "katex": "^0.19.0"
    }
  }
}
