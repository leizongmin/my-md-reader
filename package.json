{
  "name": "@leizm/my-md-reader",
  "version": "1.0.2",
  "author": "LEI Zongmin",
  "license": "MIT",
  "description": "A markdown reader extension for chrome",
  "homepage": "https://github.com/leizongmin/my-md-reader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leizongmin/my-md-reader.git"
  },
  "bugs": {
    "url": "https://github.com/leizongmin/my-md-reader/issues"
  },
  "keywords": [
    "my-md-reader",
    "markdown",
    "markdown reader",
    "chrome extension"
  ],
  "scripts": {
    "dev": "webpack --config ./build/webpack.dev.js",
    "test": "node --test test/*.test.js",
    "build": "run-s build:*",
    "build:manifest": "node ./scripts/manifest.mjs",
    "build:extension": "webpack --config ./build/webpack.prod.js",
    "build:zip": "node ./scripts/zip.mjs",
    "lint": "prettier --write --ignore-unknown",
    "preinstall": "node ./scripts/preinstall.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@nuxt/friendly-errors-webpack-plugin": "^2.6.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "archiver": "^8.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "esbuild-loader": "^4.5.0",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "svelte-loader": "^3.2.4",
    "svg-loader": "^0.0.2",
    "typescript": "^7.0.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-ext-reloader": "^1.1.13",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@md-reader/theme": "^2.0.5",
    "@mdit/plugin-alert": "^2.0.2",
    "@smui/button": "^9.0.6",
    "@smui/chips": "^9.0.6",
    "@smui/form-field": "^9.0.6",
    "@smui/radio": "^9.0.6",
    "@smui/select": "^9.0.6",
    "@smui/switch": "^9.0.6",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "highlight.js": "^11.12.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "svelte": "^5.57.2",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "**/*": "npm run lint"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "pnpm": {
    "overrides": {
      "katex": "^0.19.0",
      "webpack-ext-reloader>useragent": "npm:useragent-ng@^2.4.5"
    }
  }
}
